# All optional. Without any of these the app runs scripted explanations and a simulated chain, labelled as such.

# OpenRouter key. With it free models (ids ending in :free, enforced in web/src/engine/model.ts) write the
# explanations, read the farmer's message into fields and reword the ask the agent replies. At most
# ZISHI_MODEL_CALLS_PER_MIN calls a minute (default 10), the rest is labelled template text. Decisions stay in
# code either way. An OpenRouter key placed in AI_GATEWAY_API_KEY is also accepted.
OPENROUTER_API_KEY=
# Optional overrides, still free models only: ZISHI_TEXT_MODELS, ZISHI_OBJECT_MODELS, ZISHI_MODEL_TIMEOUT_MS.

# Private key (0x plus 64 hex) of a funded Base Sepolia wallet. Every chain event is anchored as a transaction
# from this key and the UI shows explorer links. Keep it small: it is a demo key.
SURETY_PRIVATE_KEY=

# JSON-RPC endpoint for Base Sepolia. Used to send and verify anchored transactions.
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Secret that unlocks real chain mode for one browser: open the app with ?demo=<token> once and every run
# then sends it as the x-zishi-demo header. Unset means the funded key is never used by a public visitor.
DEMO_TOKEN=

# FISCO BCOS (WeBank's consortium chain) through its Web3 JSON-RPC. All three set: in real mode every intent is also
# committed to the IntentLog on FISCO and its hash rides next to the Base one. Only these set: a real run uses FISCO
# alone. Bring a local node up with bash contracts/script/fisco.sh; the address is in contracts/deployments/fisco-bcos.json.
FISCO_RPC_URL=
FISCO_PRIVATE_KEY=
FISCO_INTENT_LOG=
# Web3 chain id of the FISCO group, 20200 by default.
FISCO_CHAIN_ID=
